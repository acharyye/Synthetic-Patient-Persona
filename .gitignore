__pycache__/
*.pyc
.env
.venv/
venv/
# Downloaded corpora are regenerable — kg_loader re-fetches Hetionet on demand.
data/*
!data/.gitkeep
# ...but prior packs and the knowledge pack are SOURCE OF TRUTH, not data dumps.
# CONDITION_EPI was migrated into prior_packs and deleted from code; the graph is
# authored, not downloaded. Losing these loses the cohort generator's priors.
!data/prior_packs/
!data/knowledge/
# The Synthea structural export is neither a corpus nor a dump: it is the
# EVIDENCE that the fixtures match reality, and test_synthea_structure.py reads
# it. "Regenerable" is the usual reason to ignore data, and it does not hold here
# — regenerating needs the exact jar, and the jar is fetched from a MUTABLE tag
# (`master-branch-latest`). Its sha256 is pinned in the MANIFEST precisely
# because the source it came from can change underneath the same URL. Losing this
# loses the only proof the loader was built against the real schema.
!data/synthea/
.pytest_cache/
*.egg-info/
.DS_Store

# SPA
ui/node_modules/
ui/dist/
ui/test-results/

# Evidence bundles are committed per release; scratch canary state is not.
evidence/*/_canary.json

# Authoring tools — kept locally, not published. These are working notes and
# agent context, not project documentation; the invariants they index are
# duplicated in module docstrings and tests, which is where they belong.
CLAUDE.md
# AGENTS.md is only a pointer to CLAUDE.md, which is ignored above — publishing
# the pointer would dangle for anyone who clones.
AGENTS.md
CLAUDE_HANDOFF.md
PLAN.md
spp_vision_and_roadmap.md
Brief.txt
protocol_ci_plan.md

# The OKF knowledge base indexes the same invariants, so it follows the same
# rule as CLAUDE.md: agent context, kept local. The tracker does NOT — steering
# is a claim about the project and belongs where a reader can check it.
docs/okf/

# tracker.html is GENERATED (build_tracker.py embeds state + the full OKF text
# into it). Committing it would publish the knowledge base the line above keeps
# local, and a rendering is not a source. Source is tracker_state.json; run
# `python3 tracker/build_tracker.py` to rebuild the view.
tracker/tracker.html

# Write-ups about the project are not the project. Drafts live locally; the
# claims they make are only as good as RELEASE.md and the evidence bundles.
linkedin_article.md
state_dumps_for_authoring.md

# Protocol CI working output (verdicts are artifacts, not source)
ci/out/
