# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5        # swap for whichever model you prefer

# Neo4j (docker-compose spins one up on these defaults).
# Host bolt port is 7688, not 7687, so this stack coexists with another Neo4j.
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

# Toggle: when false, engine/graph return deterministic stubs (no external calls)
SPP_LIVE=false
