# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# THE LIVE BACKEND DEFAULTS TO OLLAMA, NOT ANTHROPIC.
#
# This file used to offer only ANTHROPIC_*, and named no LLM_BACKEND at all. So
# a reader who set SPP_LIVE=true plus an Anthropic key got a silent attempt at
# localhost:11434, a failure, and a fallback to the null backend with one print()
# to a stdout nobody was watching. They received template prose, believed the
# model worked, and never learned why it did not. On a project whose whole claim
# is that nothing about a persona is invisible, that is the worst available
# failure mode for a first live run.
# ---------------------------------------------------------------------------

# Which backend produces persona speech. "ollama" (default) | "anthropic" | "null".
# "null" is what you get offline and in CI: a citation skeleton, structured,
# cited and verifiable — just not in words. That is the honest offline boundary,
# not a degraded mode.
LLM_BACKEND=ollama

# Ollama. Start it and pull the model BEFORE setting SPP_LIVE=true:
#   brew install ollama && ollama serve &
#   ollama pull qwen2.5:7b-instruct
# This is the model every evidence bundle from v0.1 to v0.5 was recorded against,
# pinned by digest rather than tag (a tag is a mutable pointer — a registry
# update can change weights and quantization underneath the same name).
# Changing it invalidates every cassette and requires re-running the narration
# evals; see scripts/record_narration.py and the narration.model ledger entry.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
# Seconds for one generation. A schema-constrained call against a freshly loaded
# 7B can exceed a tight timeout, and a timeout is indistinguishable from a model
# that would not respond — so this is generous by default.
OLLAMA_TIMEOUT=600

# Anthropic, only if you set LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5        # swap for whichever model you prefer

# Neo4j (docker-compose spins one up on these defaults).
# Host bolt port is 7688, not 7687, so this stack coexists with another Neo4j.
# OPTIONAL: grounding does not use Neo4j by default. The owned graph under
# data/knowledge/ is the default substrate; Hetionet via Neo4j is a second
# backend behind SPP_LIVE for larger-graph work. /health reports both, separately.
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

# Toggle: when false, engine/graph return deterministic stubs (no external calls).
# Leave this false unless Ollama (or Anthropic) is actually running — see above.
# Must be `true` or `false`; an empty value is rejected at startup rather than
# silently read as false.
SPP_LIVE=false
